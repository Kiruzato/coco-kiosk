        "must_contain": ["Almazan", "Capili", "Matriano", "Yap", "Gonzales", "Gutierrez"],
        "must_not_contain": ["I don't have verified"],
        "entity_count": 6,
        "min_confidence": "Medium"
      }
    },
    {
      "id": "SYNTH_004",
      "category": "synthetic_chunks",
      "name": "Deans - List Request",
      "query": "List all the deans of Columban College",
      "expected": {
        "mode": ["campus"],
        "must_contain": ["Almazan", "Capili"],
        "entity_count": 6
      }
    },
