{
  "version": "1.0",
  "description": "Golden test cases for CoCo RAG chatbot regression testing",
  "created": "2026-01-31",
  "test_cases": [
    {
      "id": "SYNTH_001",
      "category": "synthetic_chunks",
      "name": "Prayer - Complete Content",
      "query": "Prayer to Saint Columban",
      "expected": {
        "mode": ["campus"],
        "must_contain": ["Help Us", "beloved Columban", "through Christ our Lord", "Amen"],
        "must_not_contain": ["I don't have verified"],
        "min_confidence": "Medium",
        "expected_source_chunks": [-2]
      }
    },
    {
      "id": "SYNTH_002",
      "category": "synthetic_chunks",
      "name": "Prayer - Alternative Phrasing",
      "query": "What is the prayer to St. Columban?",
      "expected": {
        "mode": ["campus"],
        "must_contain": ["O blessed Columban", "missionary"],
        "must_not_contain": ["I don't have verified"],
        "min_confidence": "Medium"
      }
    },
    {
      "id": "SYNTH_003",
      "category": "synthetic_chunks",
      "name": "Deans - Complete Enumeration",
      "query": "Who are the deans?",
      "expected": {
