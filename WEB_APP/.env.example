# Admin Password for Login (Phase 11)
# Use a strong password for admin access
ADMIN_PASSWORD=CoCoKiosk@Engineering

# =============================================================================
# Voice Configuration (Phase 32-38)
# =============================================================================

# Master voice enable/disable (default: true)
VOICE_ENABLED=true

# Google STT Settings
GOOGLE_STT_ENABLED=true
GOOGLE_STT_QUOTA_SECONDS=3600

# Usage tracking (monitors 60-minute free tier quota)
USAGE_TRACKING_ENABLED=true
USAGE_WARN_THRESHOLD=80

# Offline TTS (Piper) - Optional, for offline operation
PIPER_MODEL_PATH=voice/models/piper/en_US-amy-medium.onnx
PIPER_CONFIG_PATH=voice/models/piper/en_US-amy-medium.onnx.json

# Cloud TTS fallback
TTS_CLOUD_FALLBACK=false

# Developer Tools Password
DEV_PASSWORD=ramkeindeliansegodi

# DEAD CODES - DOUBLE CHECK JUST INCASE

# Offline STT (Whisper.cpp) - Optional, for offline operation
WHISPER_MODEL_PATH=voice/models/whisper/ggml-tiny.en.bin
WHISPER_THREADS=4
WHISPER_CLOUD_FALLBACK=false

# Google Cloud Speech-to-Text (Phase 38)
# 1. Create a Google Cloud project: https://console.cloud.google.com
# 2. Enable the Speech-to-Text API
# 3. Create a service account with Speech-to-Text permissions
# 4. Download the JSON key file to a secure location
# 5. Set the path below (use forward slashes or escaped backslashes)
GOOGLE_APPLICATION_CREDENTIALS="google_application_credentials.json"

# OpenAI API Configuration
# Copy this file to .env and add your actual API key
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Admin API Key for Document Management System (Phase 7)
# Generate a secure key using: python -c "import uuid; print(uuid.uuid4())"
ADMIN_API_KEY=fd06dcf9-68c8-4682-a8b0-2486c2d29f60